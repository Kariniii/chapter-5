start
new a number
set a TIME
new year number
set year 0
loop z (a>31535999999)
set a a-31536000000
set year year+1
end z
new x number
set x 0
loop c (year>3)
set year year-4
set x x+1
end c ?високосные дни
new n number
set n 0
loop d (x>0)
set n n+86400000 ?вис дни в UTC
set x x-1
end d
new q number
set q TIME-n
new year1 number
set year1 0
loop year2 (q>31535999999)
set q q-31536000000
set year1 year1+1
end year2
new month number
set month 0
loop month1 (q>2591999999)
set q q-2592000000
set month month+1
end month1
new day number
set day 0
loop day2 (q>86399999)
set q q-86400000
set day day+1
end day2
set day day+1
set year1 year1+1970
set month month+1
log string "Сегодняшняя дата: " >> day >> "-" >> month>> "-" >> year1
finish
